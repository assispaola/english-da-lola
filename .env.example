# Copy this file to .env and fill in the values from your Firebase project's
# web app config (console.firebase.google.com → Project settings → General →
# Your apps → SDK setup and configuration). See CLAUDE.md for full setup steps.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
